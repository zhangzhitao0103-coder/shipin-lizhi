 "sentences": [
  {
   "id": "s1",
   "sec": "hook",
   "start": 0.55,
   "end": 3.069,
   "text": "距离高考，只剩不到两百天。"
  },
  {
   "id": "s2",
   "sec": "hook",
   "start": 3.419,
   "end": 7.564,
   "text": "冬三月，加上最后一百天，就是你的全部。"
  },
  {
   "id": "s3",
   "sec": "where",
   "start": 8.014,
   "end": 10.528,
   "text": "此刻，你正处在一轮攻坚阶段。"
  },
  {
   "id": "s4",
   "sec": "why",
   "start": 10.978,
   "end": 14.546,
   "text": "一轮复习，全面、系统、回归教材。"
  },
  {
   "id": "s5",
   "sec": "why",
   "start": 14.896,
   "end": 18.696,
   "text": "七八成分数，藏在基础和中档题里。"
  },
  {
   "id": "s6",
   "sec": "why",
   "start": 19.046,
   "end": 24.016,
   "text": "命题反套路，阅卷看步骤，拼的都是基本功。"
  },
  {
   "id": "s7",
   "sec": "why",
   "start": 24.366,
   "end": 26.14,
   "text": "一轮漏洞，二轮放大。"
  },
  {
   "id": "s8",
   "sec": "why",
   "start": 26.39,
   "end": 29.138,
   "text": "一模成绩，检验的正是一轮成色。"
  },
  {
   "id": "s9",
   "sec": "why",
   "start": 29.538,
   "end": 32.52,
   "text": "一轮定下限，二轮拉上限！"
  },
  {
   "id": "s10",
   "sec": "plan",
   "start": 33.12,
   "end": 36.234,
   "text": "十二月，攻坚薄弱，错题回炉。"
  },
  {
   "id": "s11",
   "sec": "plan",
   "start": 36.534,
   "end": 39.677,
   "text": "一月，联考检验，精准诊断。"
  },
  {
   "id": "s12",
   "sec": "plan",
   "start": 39.977,
   "end": 43.096,
   "text": "寒假，作息不放假，弯道超车。"
  },
  {
   "id": "s13",
   "sec": "plan",
   "start": 43.396,
   "end": 46.853,
   "text": "二月，一轮收官，冲向百日誓师。"
  },
  {
   "id": "s14",
   "sec": "faith",
   "start": 47.403,
   "end": 50.777,
   "text": "排名，只说明过去，不决定结局。"
  },
  {
   "id": "s15",
   "sec": "faith",
   "start": 51.177,
   "end": 53.39,
   "text": "乾坤未定，你我皆是黑马！"
  },
  {
   "id": "s16",
   "sec": "call",
   "start": 53.99,
   "end": 57.712,
   "text": "潜心奋战冬三月，夯基提能胜百天！"
  }
 ],
